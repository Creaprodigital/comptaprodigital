# =============================================================================
# ComptaPro Digital — variables d'environnement
# Copiez ce fichier en « .env » puis adaptez les valeurs.
# Ne commitez JAMAIS le fichier .env : il contient des secrets.
# =============================================================================

# --- Base de données MySQL 8 --------------------------------------------------
DATABASE_URL="mysql://comptapro:comptapro_dev@127.0.0.1:3306/comptapro"
# Base utilisée par les tests (par défaut : même URL suffixée par _test)
# TEST_DATABASE_URL="mysql://comptapro:comptapro_dev@127.0.0.1:3306/comptapro_test"

# --- Application --------------------------------------------------------------
# URL publique de l'application (https:// en production : active les cookies Secure/__Host-)
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Clé de chiffrement AES-256 (secrets MFA, IBAN) : 32 octets en base64.
#   Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""
# Durée de vie maximale d'une session et délai d'inactivité (jours)
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=14

# --- E-mails (SMTP) -----------------------------------------------------------
# Obligatoire en production. En développement, sans SMTP_HOST, les e-mails sont
# affichés dans la console (et écrits dans MAIL_CAPTURE_DIR s'il est défini).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="ComptaPro Digital <no-reply@votre-domaine.fr>"
# Destinataire des messages du formulaire de contact
CONTACT_EMAIL=""
# MAIL_CAPTURE_DIR=".mail"

# --- Répertoire Sirene ----------------------------------------------------------
# Clé d'API Sirene de l'INSEE (portail https://portail-api.insee.fr).
# Sans clé, la recherche utilise l'API publique « Recherche d'entreprises ».
INSEE_API_KEY=""

# --- Informations légales de l'éditeur (affichées sur le site) -------------------
NEXT_PUBLIC_CONTACT_EMAIL="contact@votre-domaine.fr"
NEXT_PUBLIC_LEGAL_COMPANY_NAME=""
NEXT_PUBLIC_LEGAL_FORM=""
NEXT_PUBLIC_LEGAL_ADDRESS=""
NEXT_PUBLIC_LEGAL_SIREN=""
NEXT_PUBLIC_LEGAL_RCS=""
NEXT_PUBLIC_LEGAL_VAT=""
NEXT_PUBLIC_LEGAL_DIRECTOR=""
NEXT_PUBLIC_LEGAL_HOST=""
NEXT_PUBLIC_DPO_EMAIL=""

# --- Initialisation des données (npm run db:seed) -------------------------------
# Crée le super administrateur de la plateforme s'ils sont renseignés
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Compte et entreprise de démonstration (jamais en production)
SEED_DEMO=false
# SEED_DEMO_PASSWORD=""

# --- Stockage des documents (justificatifs, factures archivées) -----------------
# Les fichiers sont chiffrés par l'application (clé dérivée de APP_ENCRYPTION_KEY) avant d'être écrits :
# perdre APP_ENCRYPTION_KEY, c'est perdre l'accès aux documents. Sauvegardez-la hors du serveur.
# "local" : dossier du serveur (à sauvegarder) — "s3" : stockage objet compatible S3
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".storage"
# Requis si STORAGE_DRIVER="s3"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Adressage par chemin (MinIO et la plupart des offres compatibles) ; "false" pour AWS S3
S3_FORCE_PATH_STYLE="true"

# --- Abonnements Stripe ----------------------------------------------------------
# Sans clé, les comptes restent en période d'essai et rien n'est facturé.
# Clé secrète (sk_test_… en recette, sk_live_… en production) — jamais exposée au navigateur.
STRIPE_SECRET_KEY=""
# Secret de signature du point de terminaison webhook (whsec_…), obligatoire en production si la clé est définie.
STRIPE_WEBHOOK_SECRET=""
# Réservé aux tests automatisés (faux serveur Stripe) ; refusé en production.
# STRIPE_API_BASE="http://127.0.0.1:12111"

# --- Production avec Docker Compose (docker-compose.yml) -------------------------
# Domaine servi par le reverse proxy (certificat HTTPS automatique)
APP_DOMAIN="app.votre-domaine.fr"
MYSQL_DATABASE="comptapro"
MYSQL_USER="comptapro"
MYSQL_PASSWORD=""
MYSQL_ROOT_PASSWORD=""
# Images publiées par le workflow de déploiement (facultatif : sinon construction locale)
# APP_IMAGE="ghcr.io/creaprodigital/comptaprodigital:latest"
# APP_TOOLS_IMAGE="ghcr.io/creaprodigital/comptaprodigital-tools:latest"
